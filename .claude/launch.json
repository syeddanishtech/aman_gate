{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aman-gate-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "video-animatic",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "video"],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    }
  ]
}

# AMAN Gate — environment configuration (copy to .env for local overrides).
# The demo runs with safe NONPRODUCTION defaults even if this file is absent.

# "demo" (default) keeps quick-login + baseline lab enabled. "production" refuses demo secrets and
# disables quick-login/baseline/reset (the app will not start until real secrets are supplied).
AMAN_ENV=demo

# Secrets — MUST be >= 32 chars. In production these MUST differ from the demo defaults or the app
# refuses to start. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AMAN_JWT_SECRET=nonproduction-demo-jwt-secret-change-me-0001
AMAN_AUDIT_HMAC_KEY=nonproduction-demo-audit-hmac-key-change-me-0001

# Database. SQLite by default; a PostgreSQL URL works unchanged, e.g.
#   AMAN_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aman_gate
# AMAN_DATABASE_URL=sqlite:///./data/aman_gate.db

# Session / approval timing
AMAN_JWT_TTL_SECONDS=3600
AMAN_APPROVAL_TTL_SECONDS=900

# Demo-only knobs (ignored/forced off in production)
AMAN_DEMO_PASSWORD=Lab-Only-Demo-2026!
AMAN_DEMO_QUICK_LOGIN=true
AMAN_ENABLE_BASELINE_LAB=true

# Upload limits
AMAN_MAX_UPLOAD_BYTES=262144
